# =====================================================================
# eDiligence - /var/www/ediligence/backend/.env
# Lu par systemd (EnvironmentFile) : pas de "export", pas d'espaces
# autour du "=", valeurs entre guillemets si elles contiennent $ ou #.
# Chmod 600, propriétaire www-data.
# =====================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=ediligence.settings
DJANGO_DEBUG=False
# Générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# ATTENTION : changer la clé invalide tous les jetons JWT existants.
SECRET_KEY=CHANGER_MOI_CLE_SECRETE_LONGUE_ET_ALEATOIRE

# --- Domaines (séparés par des virgules, sans espaces) ---
ALLOWED_HOSTS=api-diligence.numerix.digital,e-diligence.numerix.digital,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://e-diligence.numerix.digital,https://numerix.digital,https://www.numerix.digital
CSRF_TRUSTED_ORIGINS=https://api-diligence.numerix.digital,https://e-diligence.numerix.digital

# --- Base de données MySQL ---
DB_NAME=ediligence
DB_USER=ediligence
DB_PASSWORD="CHANGER_MOI_MOT_DE_PASSE_MYSQL"
DB_HOST=localhost
DB_PORT=3306

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Authentification JWT (durées en jours) ---
JWT_ACCESS_DAYS=1
JWT_REFRESH_DAYS=7

# --- Scanner de courrier ---
SCAN_WATCH_FOLDER=/var/www/ediligence/backend/scan_entrant
# IP des scanners autorisés, séparées par des virgules (vide = aucune restriction codée)
SCANNER_IPS=

# --- Notifications push (optionnel) ---
# Clé serveur FCM legacy (API désactivée par Google : laisser vide si Expo Push)
FCM_SERVER_KEY=

# --- PDF : armoiries en base64 (optionnel, en-tête des documents) ---
ARMOIRIE_BASE64=
