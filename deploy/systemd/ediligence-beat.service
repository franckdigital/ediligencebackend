[Unit]
Description=eDiligence Celery Beat
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/numerix/ediligencebackend
Environment=DJANGO_SETTINGS_MODULE=ediligence.settings
EnvironmentFile=-/var/www/numerix/ediligencebackend/.env
ExecStart=/var/www/numerix/ediligencebackend/venv/bin/celery -A ediligence beat --loglevel=info --schedule=/tmp/celerybeat-schedule
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
