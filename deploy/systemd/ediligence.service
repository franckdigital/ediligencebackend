[Unit]
Description=eDiligence Django API (gunicorn)
After=network.target redis-server.service mysql.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/numerix/ediligencebackend
Environment=DJANGO_SETTINGS_MODULE=ediligence.settings
Environment=PYTHONPATH=/var/www/numerix/ediligencebackend
Environment=PATH=/var/www/numerix/ediligencebackend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/var/www/numerix/ediligencebackend/.env
ExecStart=/var/www/numerix/ediligencebackend/venv/bin/gunicorn ediligence.wsgi:application \
    --bind 127.0.0.1:9016 --workers 3 --timeout 120 \
    --access-logfile /var/www/numerix/ediligencebackend/logs/access.log \
    --error-logfile /var/www/numerix/ediligencebackend/logs/error.log
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/www/numerix/ediligencebackend
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
