[Unit]
Description=eDiligence Celery Worker
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ediligence/backend
Environment=DJANGO_SETTINGS_MODULE=ediligence.settings
EnvironmentFile=-/var/www/ediligence/backend/.env
ExecStart=/var/www/ediligence/backend/venv/bin/celery -A ediligence worker --loglevel=info --concurrency=2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
